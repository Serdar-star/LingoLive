{
  "expo": {
    "name": "LingoLive",
    "slug": "lingolive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "lingolive",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#6C5CE7",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingolive.app",
      "buildNumber": "1",
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "LingoLive needs camera access for live video practice rooms with your language partners.",
        "NSMicrophoneUsageDescription": "LingoLive needs microphone access for pronunciation practice and live voice rooms.",
        "NSPhotoLibraryUsageDescription": "LingoLive needs photo library access so you can set a profile picture.",
        "NSSpeechRecognitionUsageDescription": "LingoLive uses speech recognition to score your pronunciation.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "com.lingolive.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FE",
          "dark": {
            "backgroundColor": "#0B0B16"
          }
        }
      ]
    ]
  }
}
